# =====================================================================
#  Serveur WebSocket ZenCow — copier en .env puis adapter
# =====================================================================

# Port et adresse d'écoute (127.0.0.1 par défaut : seul le proxy local y accède)
PORT=3000
HOST=127.0.0.1

# Environnement : production désactive GET /states
NODE_ENV=production

# Origines du SITE autorisées à se connecter (séparées par des virgules)
# ex. ALLOWED_ORIGIN=https://zencow.fr,https://www.zencow.fr
ALLOWED_ORIGIN=

# Secret partagé avec Laravel (en-tête X-WS-Secret sur /broadcast/*)
# Générer avec : openssl rand -hex 32
WS_BROADCAST_SECRET=

# Secret de signature des jetons navigateur (JWT HS256), identique côté Laravel
# Générer avec : openssl rand -hex 32
WS_JWT_SECRET=

# true : jeton navigateur et secret Laravel obligatoires
# false (défaut) : mode rétrocompatible (ancien `join` et /broadcast sans secret acceptés, avec avertissement)
WS_AUTH_REQUIRED=false

# Niveau de logs : error | warn | info | debug (défaut : info, debug hors production)
LOG_LEVEL=info

# Durée de vie des derniers états mémorisés, en heures (défaut : 24)
STATE_TTL_HOURS=24
